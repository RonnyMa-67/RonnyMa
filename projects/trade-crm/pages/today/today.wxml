<view class="page">
  <view class="hero">
    <view class="hero-item">
      <text class="hero-num {{overdue.length ? 'danger' : ''}}">{{overdue.length}}</text>
      <text class="hero-label">逾期</text>
    </view>
    <view class="hero-item">
      <text class="hero-num">{{today.length}}</text>
      <text class="hero-label">今天</text>
    </view>
    <view class="hero-item">
      <text class="hero-num">{{upcoming.length}}</text>
      <text class="hero-label">未来七天</text>
    </view>
  </view>

  <view class="section" wx:if="{{overdue.length}}">
    <view class="section-title danger-text">逾期未跟进</view>
    <customer-card
      wx:for="{{overdue}}"
      wx:key="_id"
      item="{{item}}"
      data-id="{{item._id}}"
      bind:tapcard="goDetail"
      bind:markdone="markDone"
    />
  </view>

  <view class="section" wx:if="{{today.length}}">
    <view class="section-title">今天要跟进</view>
    <customer-card
      wx:for="{{today}}"
      wx:key="_id"
      item="{{item}}"
      data-id="{{item._id}}"
      bind:tapcard="goDetail"
      bind:markdone="markDone"
    />
  </view>

  <view class="section" wx:if="{{upcoming.length}}">
    <view class="section-title">未来七天</view>
    <customer-card
      wx:for="{{upcoming}}"
      wx:key="_id"
      item="{{item}}"
      data-id="{{item._id}}"
      bind:tapcard="goDetail"
      bind:markdone="markDone"
    />
  </view>

  <view class="empty" wx:if="{{!loading && !overdue.length && !today.length && !upcoming.length}}">
    <view>今天没有待跟进的客户</view>
    <view class="muted">去客户库添加第一个客户</view>
  </view>

  <view class="fab" bindtap="goNew">＋</view>
</view>
